{
  "name": "georgedallaswebsite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test \"packages/**/*.test.mjs\"",
    "build": "node scripts/build.mjs && pnpm --filter @georgedallas/infra synth",
    "format": "node scripts/format-check.mjs",
    "local:up": "docker compose up -d postgres minio",
    "local:down": "docker compose down",
    "local:reset": "docker compose down -v && docker compose up -d postgres minio",
    "seed": "node scripts/seed-local.mjs"
  }
}
