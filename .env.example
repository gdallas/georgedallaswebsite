# Shared local defaults. Copy to .env.local and change only for local development.
APP_ENV=local
PUBLIC_SITE_URL=http://localhost:4321
CMS_PUBLIC_URL=http://localhost:3000

# Local PostgreSQL only. Do not use production URLs in local files.
DATABASE_URL=postgres://george:george-local-password@localhost:5432/georgedallas_local

# Local S3-compatible storage through MinIO.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=georgedallas-local-media
S3_ACCESS_KEY_ID=local-minio
S3_SECRET_ACCESS_KEY=local-minio-password

# Local-only placeholder secrets.
PAYLOAD_SECRET=replace-with-local-development-secret
SESSION_SECRET=replace-with-local-development-session-secret
