{
  "name": "@georgedallas/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./config-runtime": {
      "types": "./src/config-runtime.d.ts",
      "import": "./src/config.mjs",
      "default": "./src/config.mjs"
    },
    "./visibility": {
      "types": "./src/visibility.d.ts",
      "import": "./src/visibility.mjs",
      "default": "./src/visibility.mjs"
    },
    "./redirects": {
      "types": "./src/redirects.d.ts",
      "import": "./src/redirects.mjs",
      "default": "./src/redirects.mjs"
    },
    "./scheduling": {
      "types": "./src/scheduling.d.ts",
      "import": "./src/scheduling.mjs",
      "default": "./src/scheduling.mjs"
    }
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.mjs\"",
    "typecheck": "node ../../scripts/typecheck-package.mjs packages/shared"
  }
}
