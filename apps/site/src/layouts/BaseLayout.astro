---
import "../styles/cedar-circuitry.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  SITE_NAME,
  absoluteUrl,
  canonicalUrl,
  jsonLdToString
} from "../lib/seo.mjs";

// Privacy-friendly analytics beacon (GDW-048). The collector lives on the CMS
// (the only backend); baked in at build time from CMS_API_URL, empty when the
// CMS isn't configured (CI build) so the beacon simply no-ops.
const analyticsCollectorUrl = process.env.CMS_API_URL
  ? `${process.env.CMS_API_URL.replace(/\/+$/, "")}/api/analytics/collect`
  : "";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
  jsonLd?: unknown[];
  // When true (default), the page's main content is included in the Pagefind
  // search index (header/footer live outside <main>, so they are never indexed).
  // List/utility pages opt out to keep results focused on real content.
  searchable?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image,
  ogType = "website",
  jsonLd = [],
  searchable = true,
  noindex = false
} = Astro.props;

const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const ogImage = absoluteUrl(image ?? DEFAULT_OG_IMAGE, Astro.site);
const rssHref = absoluteUrl("/rss.xml", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — Writing`} href={rssHref} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={jsonLdToString(data)} />)}

    <script is:inline>
      // Apply the stored theme before first paint so there is no flash.
      // No stored value means "follow the system preference" (handled in CSS).
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.dataset.theme = stored;
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class="cc-container" data-pagefind-body={searchable || undefined}>
      <slot />
    </main>
    <SiteFooter />
    <script is:inline define:vars={{ analyticsCollectorUrl }}>
      (function () {
        try {
          if (!analyticsCollectorUrl || !navigator.sendBeacon) return;
          var path = location.pathname;
          var data = { path: path, referrer: document.referrer || "" };
          if (path === "/search") {
            var q = new URLSearchParams(location.search).get("q");
            if (q) data.query = q;
          }
          navigator.sendBeacon(analyticsCollectorUrl, new Blob([JSON.stringify(data)], { type: "text/plain" }));
        } catch (e) {
          /* analytics must never break the page */
        }
      })();
    </script>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    /* Width comes from .cc-container. Do not set width here: this scoped
       selector compiles to main[data-astro-cid-*] (specificity 0-1-1), which
       silently beats .cc-container's max-width and makes every page full-bleed. */
    flex: 1;
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -100%;
    z-index: 10;
    padding: 0.5rem 1rem;
    background: var(--surface-raised);
    color: var(--text-strong);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }

  .skip-link:focus-visible {
    top: 1rem;
  }
</style>
