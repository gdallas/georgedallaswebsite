---
import "../styles/cedar-circuitry.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  SITE_NAME,
  absoluteUrl,
  canonicalUrl,
  jsonLdToString
} from "../lib/seo.mjs";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
  jsonLd?: unknown[];
  // When true (default), the page's main content is included in the Pagefind
  // search index (header/footer live outside <main>, so they are never indexed).
  // List/utility pages opt out to keep results focused on real content.
  searchable?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image,
  ogType = "website",
  jsonLd = [],
  searchable = true,
  noindex = false
} = Astro.props;

const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const ogImage = absoluteUrl(image ?? DEFAULT_OG_IMAGE, Astro.site);
const rssHref = absoluteUrl("/rss.xml", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — Writing`} href={rssHref} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={jsonLdToString(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class="cc-container" data-pagefind-body={searchable || undefined}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    width: 100%;
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -100%;
    z-index: 10;
    padding: 0.5rem 1rem;
    background: var(--surface-raised);
    color: var(--text-strong);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }

  .skip-link:focus-visible {
    top: 1rem;
  }
</style>
