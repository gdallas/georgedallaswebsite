---
import CedarCircuitryLogo from "./brand/CedarCircuitryLogo.astro";

const navItems = [
  { label: "Writing", path: "/writing" },
  { label: "Projects", path: "/projects" },
  { label: "Bookshelf", path: "/bookshelf" },
  { label: "Now", path: "/now" },
  { label: "Links", path: "/links" },
  { label: "About", path: "/about" },
  { label: "Contact", path: "/contact" },
  { label: "Search", path: "/search" }
];

const currentPath = Astro.url.pathname;

function isActive(path: string): boolean {
  return currentPath === path || currentPath.startsWith(`${path}/`);
}
---

<header class="site-header">
  <div class="cc-container site-header__inner">
    <CedarCircuitryLogo variant="mark" />
    <nav aria-label="Main navigation">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.path} aria-current={isActive(item.path) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-block-end: 1px solid var(--border);
    background: var(--surface);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding-block: 1rem;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-block;
    padding: 0.4rem 0.7rem;
    border-radius: 0.5rem;
    color: var(--text);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent);
  }

  nav a:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 2px;
  }

  nav a[aria-current="page"] {
    color: var(--text-strong);
    background: var(--surface-raised);
  }
</style>
