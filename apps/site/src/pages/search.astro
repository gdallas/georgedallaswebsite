---
import BaseLayout from "../layouts/BaseLayout.astro";

// Public search (GDW-036), powered by Pagefind. The index and UI assets under
// /pagefind/ are generated by `pagefind --site dist` after `astro build`, so
// they are referenced as runtime URLs (is:inline) rather than Astro imports.
// This page opts out of the index itself (searchable={false}) and is noindex.
---

<BaseLayout
  title="Search — George Dallas"
  description="Search essays, projects, and pages on georgedallas.com."
  searchable={false}
  noindex
>
  <article class="cc-content">
    <h1 class="cc-heading cc-heading--hero">Search</h1>
    <p class="cc-muted">Search essays, projects, and pages.</p>
    <div id="search" class="search-ui"></div>
    <noscript>
      <p class="cc-muted">Search needs JavaScript enabled. Browse <a href="/writing">Writing</a> instead.</p>
    </noscript>
  </article>
</BaseLayout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  function initSearch() {
    if (typeof window.PagefindUI === "undefined") {
      window.setTimeout(initSearch, 50);
      return;
    }
    new window.PagefindUI({
      element: "#search",
      showImages: false,
      showSubResults: true,
      excerptLength: 25
    });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSearch);
  } else {
    initSearch();
  }
</script>

<style>
  .search-ui {
    margin-block-start: 1.5rem;
  }

  /* Map Pagefind's default UI onto the cedar-circuitry palette. */
  .search-ui {
    --pagefind-ui-primary: var(--accent-strong, var(--accent));
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--surface-raised);
    --pagefind-ui-border-radius: 0.5rem;
    --pagefind-ui-font: inherit;
  }
</style>
