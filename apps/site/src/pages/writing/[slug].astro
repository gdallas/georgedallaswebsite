---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagChips from "../../components/TagChips.astro";
import { loadPublishedPosts } from "../../lib/content.mjs";
import { renderRichText } from "../../lib/richText.mjs";
import { articleJsonLd } from "../../lib/seo.mjs";

export async function getStaticPaths() {
  const posts = await loadPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const bodyHtml = renderRichText(post.body);
const jsonLd = [articleJsonLd(post, { site: Astro.site })];

function formatDate(value: string | null | undefined) {
  return value ? new Date(value).toLocaleDateString("en-CA", { dateStyle: "long" }) : "";
}
---

<BaseLayout
  title={`${post.seoTitle ?? post.title} — George Dallas`}
  description={post.seoDescription ?? post.excerpt ?? undefined}
  image={post.socialImage?.url ?? post.featuredImage?.url ?? undefined}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="cc-content">
    <p class="cc-eyebrow"><a href="/writing">Writing</a></p>
    <h1 class="cc-heading cc-heading--hero">{post.title}</h1>
    <p class="cc-muted post-meta">
      {formatDate(post.publishedAt)}
      {post.readingTime ? ` · ${post.readingTime} min read` : ""}
    </p>
    <TagChips tags={post.tags} class="post-page-chips" />
    {bodyHtml ? <div class="cc-prose" set:html={bodyHtml} /> : <p class="cc-muted">This post has no content yet.</p>}
  </article>
</BaseLayout>

<style>
  .cc-eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .cc-eyebrow a:hover {
    color: var(--accent);
  }
  .post-meta {
    margin-block: 0.5rem 2rem;
  }
  .post-meta:has(+ :global(.post-page-chips)) {
    margin-block-end: 0.75rem;
  }
  :global(.post-page-chips) {
    margin-block-end: 2rem;
  }
</style>
