---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagChips from "../../components/TagChips.astro";
import { loadPublishedPosts } from "../../lib/content.mjs";

const posts = await loadPublishedPosts();
const [featured, ...rest] = posts;

function formatDate(value: string | null | undefined) {
  return value ? new Date(value).toLocaleDateString("en-CA", { dateStyle: "long" }) : "";
}
---

<BaseLayout title="Writing — George Dallas" description="Essays and notes on AI systems, therapy, and the places they meet." searchable={false}>
  <header class="page-head">
    <h1 class="cc-heading cc-heading--hero">Writing</h1>
    <p class="cc-muted">Long-form notes on AI systems, therapy, and the places they meet.</p>
  </header>

  {
    posts.length === 0 ? (
      <p class="cc-muted">No published writing yet — check back soon.</p>
    ) : (
      <>
        <article class="cc-card cc-card--interactive featured-post">
          <p class="cc-eyebrow">Latest</p>
          <h2 class="cc-heading cc-heading--section">
            <a href={`/writing/${featured.slug}`}>{featured.title}</a>
          </h2>
          <p class="cc-muted post-meta">
            {formatDate(featured.publishedAt)}
            {featured.readingTime ? ` · ${featured.readingTime} min read` : ""}
          </p>
          <TagChips tags={featured.tags} class="post-chips" />
          {featured.excerpt && <p class="featured-post__excerpt">{featured.excerpt}</p>}
        </article>

        <ul class="post-list">
          {rest.map((post) => (
            <li>
              <article class="cc-card cc-card--interactive post-card">
                <h2 class="cc-heading cc-heading--card">
                  <a href={`/writing/${post.slug}`}>{post.title}</a>
                </h2>
                <p class="cc-muted post-meta">
                  {formatDate(post.publishedAt)}
                  {post.readingTime ? ` · ${post.readingTime} min read` : ""}
                </p>
                <TagChips tags={post.tags} class="post-chips" />
                {post.excerpt && <p>{post.excerpt}</p>}
              </article>
            </li>
          ))}
        </ul>
      </>
    )
  }
</BaseLayout>

<style>
  .page-head {
    margin-block-end: 2rem;
  }
  .page-head p {
    margin-block-start: 0.5rem;
  }
  .featured-post {
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    margin-block-end: 1.5rem;
    border-color: color-mix(in srgb, var(--accent) 32%, var(--border));
  }
  .featured-post .cc-eyebrow {
    margin: 0 0 0.75rem;
  }
  .featured-post h2 {
    margin: 0;
  }
  .featured-post__excerpt {
    margin-block-end: 0;
    max-width: 60ch;
  }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .post-card {
    padding: clamp(1.25rem, 2vw, 1.75rem);
  }
  .post-card h2 {
    margin: 0;
  }
  .post-card p:last-child {
    margin-block-end: 0;
  }
  .post-meta {
    font-size: 0.9rem;
    margin-block: 0.35rem 0.75rem;
  }
  :global(.post-chips) {
    margin-block-end: 0.75rem;
  }
  .featured-post h2 a,
  .post-card h2 a {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .featured-post h2 a:hover,
  .post-card h2 a:hover {
    color: var(--accent);
  }
</style>
