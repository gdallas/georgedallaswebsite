---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { loadProjects } from "../../lib/content.mjs";

const projects = await loadProjects();
const featured = projects.filter((project) => project.featured);
const rest = projects.filter((project) => !project.featured);
---

<BaseLayout title="Projects — George Dallas" description="Selected software and systems work, with the reasoning behind it.">
  <header class="page-head">
    <h1 class="cc-heading cc-heading--hero">Projects</h1>
    <p class="cc-muted">Selected software and systems work, with the reasoning behind it.</p>
  </header>

  {
    projects.length === 0 ? (
      <p class="cc-muted">No public projects yet — check back soon.</p>
    ) : (
      <>
        {featured.length > 0 && (
          <section class="project-featured" aria-label="Featured projects">
            {featured.map((project) => (
              <ProjectCard project={project} featured />
            ))}
          </section>
        )}
        {rest.length > 0 && (
          <ul class="project-grid">
            {rest.map((project) => (
              <li>
                <ProjectCard project={project} />
              </li>
            ))}
          </ul>
        )}
      </>
    )
  }
</BaseLayout>

<style>
  .page-head {
    margin-block-end: 2rem;
  }
  .page-head p {
    margin-block-start: 0.5rem;
  }
  .project-featured {
    display: grid;
    gap: 1.5rem;
    margin-block-end: 1.5rem;
  }
  .project-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1.5rem;
  }
</style>
