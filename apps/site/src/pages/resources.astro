---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadPublishedPage } from "../lib/content.mjs";
import { renderRichText } from "../lib/richText.mjs";

const page = await loadPublishedPage("resources");
const bodyHtml = page ? renderRichText(page.body) : "";
---

<BaseLayout
  title={page?.seoTitle ? `${page.seoTitle} — George Dallas` : "Resources — George Dallas"}
  description={page?.seoDescription ?? "Tools, references, and links George Dallas finds useful."}
>
  <article class="cc-content">
    <h1 class="cc-heading cc-heading--hero">{page?.title ?? "Resources"}</h1>
    {
      page && bodyHtml ? (
        <div class="cc-prose" set:html={bodyHtml} />
      ) : (
        <p class="cc-muted">This page hasn't been published yet.</p>
      )
    }
  </article>
</BaseLayout>
