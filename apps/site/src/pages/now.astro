---
import type { PublicNowEntry, PublicNowPage } from "../lib/cms.mjs";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadNowHistory, loadNowPage } from "../lib/content.mjs";

const now = await loadNowPage();
const rows = (entry: PublicNowPage | PublicNowEntry) =>
  [
    ["Current focus", entry.currentFocus],
    ["Work", entry.work],
    ["Reading", entry.reading],
    ["Listening", entry.listening],
    ["Watching", entry.watching],
    ["Personal", entry.personal]
  ].filter(([, value]) => value);

const sections = now ? rows(now) : [];

const updated = now?.updatedAt ? new Date(now.updatedAt).toLocaleDateString("en-CA", { dateStyle: "long" }) : "";

// Public archive of past Now entries (George, 2026-07-09). Drop the most recent
// snapshot if it is identical to what's live, so the current Now isn't echoed.
const history = await loadNowHistory();
const currentSignature = sections.map(([, value]) => String(value ?? "").trim()).join(" ");
const pastEntries = history
  .map((entry) => ({ entry, rows: rows(entry) }))
  .filter(({ rows: r }) => r.length > 0)
  .filter(({ rows: r }, index) => !(index === 0 && r.map(([, v]) => String(v ?? "").trim()).join(" ") === currentSignature));

const formatCaptured = (value: string | null | undefined) =>
  value ? new Date(value).toLocaleDateString("en-CA", { dateStyle: "long" }) : "";
---

<BaseLayout title="Now — George Dallas" description="What George Dallas is focused on right now.">
  <header class="page-head">
    <h1 class="cc-heading cc-heading--hero">Now</h1>
    <p class="cc-muted">
      A snapshot of what I'm focused on at the moment{updated ? `, last updated ${updated}` : ""}.
    </p>
  </header>

  {
    sections.length === 0 ? (
      <p class="cc-muted">The Now page hasn't been published yet.</p>
    ) : (
      <dl class="now-list">
        {sections.map(([label, value]) => (
          <div class="now-row">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  {
    pastEntries.length > 0 && (
      <section class="now-history">
        <h2 class="cc-heading cc-heading--section">Previously</h2>
        <p class="cc-muted">Earlier snapshots of this page.</p>
        {pastEntries.map(({ entry, rows: entryRows }) => (
          <article class="now-past">
            <h3 class="now-past__date">{formatCaptured(entry.capturedAt)}</h3>
            <dl class="now-list">
              {entryRows.map(([label, value]) => (
                <div class="now-row">
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </section>
    )
  }
</BaseLayout>

<style>
  .page-head {
    margin-block-end: 2rem;
  }
  .page-head p {
    margin-block-start: 0.5rem;
  }
  .now-list {
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }
  .now-row {
    border-block-start: 1px solid var(--border);
    padding-block-start: 1.25rem;
  }
  .now-row dt {
    color: var(--text-muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-block-end: 0.35rem;
  }
  .now-row dd {
    margin: 0;
    white-space: pre-line;
  }
  .now-history {
    margin-block-start: 3.5rem;
    border-block-start: 1px solid var(--border);
    padding-block-start: 2rem;
  }
  .now-history > p {
    margin-block: 0.25rem 2rem;
  }
  .now-past {
    margin-block-end: 2.5rem;
  }
  .now-past__date {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-block-end: 1rem;
  }
</style>
