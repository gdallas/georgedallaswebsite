---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandButton from "../components/brand/BrandButton.astro";
import BrandCard from "../components/brand/BrandCard.astro";
import TagChips from "../components/TagChips.astro";
import {
  loadCurrentlyReadingBooks,
  loadNowPage,
  loadProjects,
  loadPublishedPosts,
  loadTimelineEntries
} from "../lib/content.mjs";
import { personJsonLd, websiteJsonLd } from "../lib/seo.mjs";

const description =
  "George Dallas - AI engineer, therapist, and systems thinker on Vancouver Island. Writing, projects, and an honest record of what I'm working on now.";
const jsonLd = [websiteJsonLd({ site: Astro.site }), personJsonLd({ site: Astro.site })];

const [posts, projects, nowPage, readingNow, timelineEntries] = await Promise.all([
  loadPublishedPosts(),
  loadProjects(),
  loadNowPage(),
  loadCurrentlyReadingBooks(),
  loadTimelineEntries()
]);

const recentPosts = posts.slice(0, 3);
// Featured projects first, then CMS sort order (already applied by the API).
const featuredProjects = [...projects]
  .sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)))
  .slice(0, 3);
const hasTimeline = timelineEntries.length > 0;

// The Now panel leads with the current focus; the remaining facets fill in
// underneath, but only the ones George has actually filled in.
const nowFacets = nowPage
  ? ([
      ["Working on", nowPage.work],
      ["Reading", nowPage.reading],
      ["Listening", nowPage.listening],
      ["Watching", nowPage.watching],
      ["Personal", nowPage.personal]
    ] as const).filter(([, value]) => value)
  : [];

function formatDate(value: string | null | undefined) {
  return value ? new Date(value).toLocaleDateString("en-CA", { dateStyle: "long" }) : "";
}

const nowUpdated = formatDate(nowPage?.updatedAt);
---

<BaseLayout title="George Dallas - AI engineer, therapist, systems thinker" description={description} jsonLd={jsonLd} searchable={false}>
  <section class="cc-hero cc-hero--photo home-hero">
    <picture>
      <source
        type="image/avif"
        srcset="/images/home/star-trails-960.avif 960w, /images/home/star-trails-1600.avif 1600w, /images/home/star-trails-2400.avif 2400w"
        sizes="(max-width: 74rem) 100vw, 72rem"
      />
      <img
        class="cc-hero__backdrop"
        src="/images/home/star-trails-1600.jpg"
        srcset="/images/home/star-trails-960.jpg 960w, /images/home/star-trails-1600.jpg 1600w, /images/home/star-trails-2400.jpg 2400w"
        sizes="(max-width: 74rem) 100vw, 72rem"
        alt=""
        width="6016"
        height="2650"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="home-hero__content">
      <p class="cc-eyebrow">George Dallas</p>
      <h1 class="cc-heading cc-heading--hero">
        AI engineer. Therapist. Systems thinker. Based on Vancouver Island.
      </h1>
      <p class="cc-muted">
        Writing, projects, and an honest record of what I'm working on - updated weekly, hosted quietly.
      </p>
      <div class="hero-actions">
        <BrandButton href="/about" variant="primary">About me</BrandButton>
        <BrandButton href="/writing" variant="secondary">Read the writing</BrandButton>
      </div>
    </div>
  </section>

  <hr class="cc-divider" />

  <section aria-labelledby="now-heading">
    <div class="section-head">
      <h2 id="now-heading" class="cc-heading cc-heading--section">Now</h2>
      <a class="section-link" href="/now">The full update</a>
    </div>
    {
      nowPage?.currentFocus ? (
        <div class="now-panel">
          <p class="cc-eyebrow now-panel__eyebrow">Currently focused on</p>
          <p class="now-panel__focus">{nowPage.currentFocus}</p>
          {nowFacets.length > 0 && (
            <dl class="now-panel__facets">
              {nowFacets.map(([label, value]) => (
                <div class="now-panel__facet">
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          )}
          {nowUpdated && <p class="now-panel__meta">Updated {nowUpdated}</p>}
        </div>
      ) : (
        <p class="cc-muted">A living snapshot of what I'm focused on - the next update lands on the Now page.</p>
      )
    }
  </section>

  <hr class="cc-divider" />

  <section aria-labelledby="writing-heading">
    <div class="section-head">
      <h2 id="writing-heading" class="cc-heading cc-heading--section">Recent writing</h2>
      <a class="section-link" href="/writing">All writing</a>
    </div>
    {
      recentPosts.length > 0 ? (
        <ul class="post-list">
          {recentPosts.map((post) => (
            <li>
              <article class="post-teaser">
                <h3 class="cc-heading cc-heading--card">
                  <a href={`/writing/${post.slug}`}>{post.title}</a>
                </h3>
                <p class="cc-muted post-teaser__meta">
                  {formatDate(post.publishedAt)}
                  {post.readingTime ? ` · ${post.readingTime} min read` : ""}
                </p>
                <TagChips tags={post.tags} class="post-teaser__chips" />
                {post.excerpt && <p class="post-teaser__excerpt">{post.excerpt}</p>}
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <p class="cc-muted">The first essays are on their way - the writing page will fill up soon.</p>
      )
    }
  </section>

  <figure class="photo-band">
    <picture>
      <source
        type="image/avif"
        srcset="/images/home/rialto-sunset-960.avif 960w, /images/home/rialto-sunset-1600.avif 1600w, /images/home/rialto-sunset-2400.avif 2400w"
        sizes="(max-width: 74rem) 100vw, 72rem"
      />
      <img
        src="/images/home/rialto-sunset-1600.jpg"
        srcset="/images/home/rialto-sunset-960.jpg 960w, /images/home/rialto-sunset-1600.jpg 1600w, /images/home/rialto-sunset-2400.jpg 2400w"
        sizes="(max-width: 74rem) 100vw, 72rem"
        alt="A sea stack silhouetted against an orange sunset over the Pacific, waves rolling toward a dark gravel beach"
        width="6000"
        height="2100"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <figcaption>Dusk on the Pacific Northwest coast — Rialto Beach, Olympic Peninsula.</figcaption>
  </figure>

  <section aria-labelledby="projects-heading">
    <div class="section-head">
      <h2 id="projects-heading" class="cc-heading cc-heading--section">Projects</h2>
      <a class="section-link" href="/projects">All projects</a>
    </div>
    {
      featuredProjects.length > 0 ? (
        <div class="card-grid">
          {featuredProjects.map((project) => (
            <BrandCard eyebrow={project.featured ? "Featured" : "Project"} title={project.title}>
              {project.summary && <p>{project.summary}</p>}
            </BrandCard>
          ))}
        </div>
      ) : (
        <p class="cc-muted">Public write-ups of selected software and systems work are coming - the projects page has the details as they publish.</p>
      )
    }
  </section>

  <hr class="cc-divider" />

  <section aria-labelledby="explore-heading">
    <h2 id="explore-heading" class="cc-heading cc-heading--section">Explore</h2>
    <div class="card-grid">
      <BrandCard eyebrow="Bookshelf" title="Reading log" href="/bookshelf">
        {
          readingNow.length > 0 ? (
            <p>Currently reading {readingNow.slice(0, 2).map((book) => book.title).join(" and ")}.</p>
          ) : (
            <p>Books, notes, and reading-now entries as they get published.</p>
          )
        }
      </BrandCard>
      {
        hasTimeline && (
          <BrandCard eyebrow="Timeline" title="The story so far" href="/timeline">
            <p>Milestones in work, learning, and life - drawn as a cedar tree.</p>
          </BrandCard>
        )
      }
      <BrandCard eyebrow="Links" title="Around the web" href="/links">
        <p>Profiles and places I keep things - all in one spot.</p>
      </BrandCard>
      <BrandCard eyebrow="Contact" title="Say hello" href="/contact">
        <p>A quiet contact form that lands straight in my inbox.</p>
      </BrandCard>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(22rem, 46vw, 30rem);
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .home-hero__content {
    max-width: 46rem;
  }

  .home-hero h1 {
    margin-block: 0.5rem 0;
  }

  .home-hero .cc-muted {
    max-width: 38rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 1.5rem;
  }

  .photo-band {
    position: relative;
    margin: clamp(2rem, 5vw, 3.5rem) 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-soft);
  }

  .photo-band img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 20 / 7;
    object-fit: cover;
  }

  @media (max-width: 40rem) {
    .photo-band img {
      aspect-ratio: 16 / 10;
    }
  }

  .photo-band figcaption {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: 2.25rem 1.25rem 0.85rem;
    background: linear-gradient(0deg, rgb(24 18 14 / 0.7), transparent);
    color: #e8ddcb;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-align: right;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .section-link {
    color: var(--link);
    text-decoration: none;
    white-space: nowrap;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem;
    margin-block-start: 1.25rem;
  }

  .post-list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .post-teaser h3 {
    margin: 0;
  }

  .post-teaser h3 a {
    color: inherit;
    text-decoration: none;
  }

  .post-teaser h3 a:hover {
    color: var(--accent);
  }

  .post-teaser__meta {
    margin-block: 0.25rem 0.5rem;
    font-size: 0.9rem;
  }

  .post-teaser__excerpt {
    margin: 0;
    color: var(--text-muted);
  }

  :global(.post-teaser__chips) {
    margin-block-end: 0.5rem;
  }

  .now-panel {
    margin-block-start: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--border);
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--radius-lg);
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--surface-raised) 42%, var(--surface)),
      var(--surface)
    );
    box-shadow: var(--shadow-card);
  }

  .now-panel__eyebrow {
    margin: 0 0 0.65rem;
  }

  .now-panel__focus {
    margin: 0;
    max-width: 42rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1rem + 1.6vw, 1.95rem);
    line-height: 1.35;
    color: var(--text-strong);
    text-wrap: balance;
  }

  .now-panel__facets {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.1rem 1.75rem;
    margin: 1.75rem 0 0;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--border);
  }

  .now-panel__facet dt {
    margin-block-end: 0.35rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .now-panel__facet dd {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.6;
    white-space: pre-line;
  }

  .now-panel__meta {
    margin: 1.5rem 0 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
  }
</style>
